      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Razarth.Core.Domain\Razarth.Core.Domain.csproj" />
    <ProjectReference Include="..\..\src\Razarth.Core.Application\Razarth.Core.Application.csproj" />
    <ProjectReference Include="..\..\src\Razarth.Core.Infrastructure\Razarth.Core.Infrastructure.csproj" />
  </ItemGroup>

