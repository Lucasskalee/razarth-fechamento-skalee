    <AssemblyName>Razarth.Tests.Unit</AssemblyName>
    <RootNamespace>Razarth.Tests.Unit</RootNamespace>
    <Nullable>enable</Nullable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.7.0" />
